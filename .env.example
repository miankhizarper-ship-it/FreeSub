# ---------------------------------------------------------------------------
# FreeSub environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit the real `.env` file to version control.
# ---------------------------------------------------------------------------

# Application
APP_NAME="FreeSub"
APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # ALWAYS false in production
APP_URL=                     # No trailing slash, e.g. https://freesub.example.com. Empty = auto-detect from the request.
APP_TIMEZONE=UTC              # e.g. Asia/Karachi
APP_KEY=                      # 32+ random chars: php -r "echo bin2hex(random_bytes(32));"

# Database (MySQL 8 / MariaDB 10.6+)
DB_DRIVER=mysql               # mysql (production) | sqlite (local smoke tests only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freesub
DB_USERNAME=freesub
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SQLite path, only used when DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database.sqlite

# Sessions
SESSION_NAME=freesub_session
SESSION_LIFETIME=120          # minutes of inactivity
SESSION_SECURE=auto           # auto | true | false
SESSION_SAMESITE=Lax

# Security
SECURITY_FORCE_HTTPS=false    # true when the site is served over TLS
SECURITY_HSTS=false           # only enable with a working HTTPS setup
TRUSTED_PROXIES=              # comma separated CIDRs, e.g. 10.0.0.0/8,127.0.0.1

RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=900   # seconds
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW=3600

# Subdomain policy
SUBDOMAIN_MIN_LENGTH=3
SUBDOMAIN_MAX_LENGTH=32
SUBDOMAIN_DEFAULT_QUOTA=5     # DB value on the domain row overrides this

# DNS provider integration (NOT IMPLEMENTED YET - foundation only)
# Tokens live in the environment only, never in the database or public JS.
DNS_PROVIDER=none             # none | cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4

# Abuse contact shown on public pages
ABUSE_EMAIL=abuse@kharcha.info
SUPPORT_EMAIL=support@kharcha.info
