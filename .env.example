# ---------------------------------------------------------------------------
# FreeSub environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit the real `.env` file to version control.
# ---------------------------------------------------------------------------

# Application
APP_NAME="FreeSub"
APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # ALWAYS false in production
APP_URL=                     # No trailing slash, e.g. https://freesub.example.com. Empty = auto-detect from the request.
APP_TIMEZONE=UTC              # e.g. Asia/Karachi
APP_KEY=                      # 32+ random chars: php -r "echo bin2hex(random_bytes(32));"

# Database (MySQL 8 / MariaDB 10.6+)
DB_DRIVER=mysql               # mysql (production) | sqlite (local smoke tests only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=freesub
DB_USERNAME=freesub
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SQLite path, only used when DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database.sqlite

# Sessions
SESSION_NAME=freesub_session
SESSION_LIFETIME=120          # minutes of inactivity
SESSION_SECURE=auto           # auto | true | false
SESSION_SAMESITE=Lax

# Security
SECURITY_FORCE_HTTPS=false    # true when the site is served over TLS
SECURITY_HSTS=false           # only enable with a working HTTPS setup
TRUSTED_PROXIES=              # comma separated CIDRs, e.g. 10.0.0.0/8,127.0.0.1

RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=900   # seconds
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW=3600

# Subdomain policy
SUBDOMAIN_MIN_LENGTH=3
SUBDOMAIN_MAX_LENGTH=32
SUBDOMAIN_DEFAULT_QUOTA=5     # DB value on the domain row overrides this

# ---------------------------------------------------------------------------
# Clerk authentication (identity provider)
#
# Only the publishable key may ever reach the browser. The secret key stays on
# the server: it is never rendered, never logged and never stored in the
# database. CLERK_WEBHOOK_SECRET may stay empty until webhooks are enabled.
# ---------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=        # pk_test_... / pk_live_... (safe to expose)
CLERK_SECRET_KEY=             # sk_test_... / sk_live_... SERVER ONLY. Never commit.
CLERK_AUTHORIZED_PARTIES=     # comma separated origins, e.g. https://freesub.example.com. Empty = APP_URL
CLERK_WEBHOOK_SECRET=         # whsec_... only if Clerk webhooks are enabled (not required)
CLERK_FRONTEND_API=           # optional override; normally derived from the publishable key
CLERK_JWKS_URL=               # optional override; normally <frontend api>/.well-known/jwks.json
CLERK_AUDIENCES=              # optional; only if your Clerk instance sets an `aud` claim
CLERK_JWT_TEMPLATE=freesub_handoff  # JWT template that mints the handoff token
CLERK_JS_VERSION=6.46.3       # pinned @clerk/clerk-js version
CLERK_CLOCK_SKEW=5            # seconds of tolerance for exp/nbf
CLERK_JWKS_CACHE_TTL=300      # seconds to cache signing keys on disk
CLERK_SESSION_RECHECK=60      # seconds between "is this Clerk session still alive?" checks
CLERK_HANDOFF_TTL=120         # lifetime of the browser handoff channel
CLERK_TICKET_TTL=60           # lifetime of the single-use handoff token
CLERK_BREAK_GLASS=false       # allow `php database/break-glass.php` (offline admin access)
BREAK_GLASS_TTL=300           # lifetime of an offline admin link

# ---------------------------------------------------------------------------
# DNS engine (Cloudflare)
#
# The engine is READ-ONLY in this build: the admin diagnostics page and
# `php database/dns-sync.php` can verify the zone and compare records, but no
# user-facing flow creates DNS and public registration stays disabled.
#
# The token is a SECRET: it is read from the environment only, never stored in
# the database, never rendered and never logged. Create it in the Cloudflare
# dashboard with exactly two permissions, scoped to the one zone:
#     Zone → DNS → Edit
#     Zone → Zone → Read
# The zone id is a public identifier (it appears in the dashboard URL), so it may
# live in `domains.zone_reference`; the token must not.
# ---------------------------------------------------------------------------
DNS_PROVIDER=none             # none | cloudflare (cloudflare needs both values below)
DNS_ROOT_DOMAIN=kharcha.info  # the ONLY apex this installation may write to
CLOUDFLARE_API_TOKEN=         # server-side only. Never commit, never expose.
CLOUDFLARE_ZONE_ID=           # 32 hex chars, from the zone's Overview page
CLOUDFLARE_ACCOUNT_ID=        # optional, informational
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4   # https enforced

# Timeouts and retry policy. Retries apply to reads only; a create is never
# retried blindly (a timeout may follow a successful write).
CLOUDFLARE_CONNECT_TIMEOUT=5  # seconds
CLOUDFLARE_TIMEOUT=15         # seconds, whole request
CLOUDFLARE_MAX_RETRIES=2      # idempotent reads only
CLOUDFLARE_RETRY_BACKOFF_MS=250
CLOUDFLARE_MAX_PAGES=10       # caps a zone listing at 1000 records
CLOUDFLARE_DEFAULT_TTL=1      # 1 = automatic

# ---------------------------------------------------------------------------
# Subdomain availability, reservations and quota
# ---------------------------------------------------------------------------
# A new account may hold this many names (subdomains + pending requests).
# `domains.subdomain_quota` overrides it per root domain, and
# `users.subdomain_quota` overrides it per account. 0–500; enforced server-side.
SUBDOMAIN_INITIAL_QUOTA=2
# How long a pending reservation holds its label before it lapses (hours).
RESERVATION_TTL_HOURS=168
# Availability lookups are cached on disk; keep these short enough that a stale
# "free" cannot outlive a human's attention span. Errors are never cached.
AVAILABILITY_CACHE_TTL=300
AVAILABILITY_NEGATIVE_CACHE_TTL=30
AVAILABILITY_FAIL_CLOSED=true  # an unreachable provider must never mean "free"

# ---------------------------------------------------------------------------
# DNS provisioning queue (Task 04)
# ---------------------------------------------------------------------------
# Where a provisioned subdomain points. Server-side only: a user picks a name,
# never a destination. At least one of A/AAAA (or CNAME if neither) must be set,
# or the worker refuses to run instead of guessing.
DNS_PROVISIONING_A=            # e.g. 203.0.114.10 (must be a public address)
DNS_PROVISIONING_AAAA=         # optional IPv6
DNS_PROVISIONING_CNAME=        # used only when no A/AAAA is set
# Refuse to provision unless the zone is verified against the token.
PROVISIONING_REQUIRE_VERIFIED_ZONE=true
PROVISIONING_MAX_ATTEMPTS=5    # bounded automatic retries, exponential backoff
PROVISIONING_VERIFY_DELAY_MS=0 # wait before the read-back (Cloudflare is fast)
PROVISIONING_LOCK_TIMEOUT=300  # a running job older than this is reclaimed

# Abuse contact shown on public pages
ABUSE_EMAIL=abuse@kharcha.info
SUPPORT_EMAIL=support@kharcha.info
