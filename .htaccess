# ===========================================================================
# FreeSub — Apache configuration
#
# Works with Apache 2.4 (mod_rewrite, mod_headers, mod_deflate). If any module
# is missing, wrap its block in an <IfModule> guard — the app itself does not
# depend on these rules, they are hardening + convenience only.
# ===========================================================================

# --- Default document -------------------------------------------------------
DirectoryIndex index.php index.html

# --- Turn off directory listings -------------------------------------------
Options -Indexes +FollowSymLinks

# --- Protect dot files (.env, .git, .htaccess, .user.ini) -------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|phpunit\.xml(\.dist)?|\.env(\..*)?)$">
    Require all denied
</FilesMatch>

# --- Block direct access to application internals ---------------------------
# (config/, includes/, storage/, database/, tests/ also ship their own
# .htaccess files; these rules are the belt to that suspenders and also cover
# sub-directory installs.)
RedirectMatch 404 ^/(config|includes|storage|database|tests)/

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header unset X-Powered-By
    Header unset Server

    # Content-Security-Policy: all assets are same-origin, inline styles are
    # used for a handful of progress bars, inline scripts only for the small
    # setup fallback page, so keep 'unsafe-inline' for style only.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'"
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Caching for static assets ---------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

# --- Force HTTPS (uncomment once TLS is verified) --------------------------
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteCond %{HTTP:X-Forwarded-Proto} !https
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# --- Friendly errors --------------------------------------------------------
ErrorDocument 403 /404.php
ErrorDocument 404 /404.php
ErrorDocument 419 /404.php

# --- PHP hardening (only applies when PHP runs as an Apache module) --------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.use_strict_mode 1
    php_value session.use_only_cookies 1
    php_value session.cookie_httponly 1
    php_flag expose_php Off
</IfModule>

<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.use_strict_mode 1
    php_value session.use_only_cookies 1
    php_value session.cookie_httponly 1
    php_flag expose_php Off
</IfModule>
