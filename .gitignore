# Environment & secrets
.env
.env.*
!.env.example

# Runtime state (never commit user data or logs)
storage/logs/*
!storage/logs/.gitkeep
!storage/logs/.htaccess
storage/cache/*
!storage/cache/.gitkeep
!storage/cache/.htaccess
storage/sessions/*
!storage/sessions/.gitkeep
!storage/sessions/.htaccess
storage/*.sqlite
storage/*.sqlite-*

# Dependencies
# The application runs without vendor/; composer.json declares the official
# Clerk SDK for deployments that prefer it (see composer.lock.md).
/vendor/
composer.lock

/node_modules/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local test scratch
/tests/tmp/
